# Exemplo didático: este site estático não lê variáveis de ambiente.
# Nenhuma variável é necessária para executar o site atual.
# Na Fase A, a configuração pública do Supabase fica em assets/js/supabase-client.js.
# Guarde segredos reais de futuras integrações fora da pasta do projeto.

# URI MongoDB: somente no backend; usuário específico com menor privilégio.
MONGO_URI="mongodb+srv://USUARIO_EXEMPLO:SENHA_EXEMPLO@cluster.exemplo.invalid/meubanco"

# URL do projeto Supabase: identificador público; este arquivo é só referência.
SUPABASE_URL="https://projeto-exemplo.supabase.co"
# Chave pública atual; exige permissões e políticas RLS adequadas.
SUPABASE_PUBLISHABLE_KEY="SUBSTITUA_PELA_CHAVE_PUBLICA"
# Tipo público legado, apresentado para compreensão do material do curso.
SUPABASE_ANON_KEY="SUBSTITUA_PELA_CHAVE_ANON_LEGADA"
# Chaves privilegiadas: apenas servidor; nunca incluir no frontend ou build.
SUPABASE_SECRET_KEY="SUBSTITUA_PELA_CHAVE_SECRETA_NO_SERVIDOR"
SUPABASE_SERVICE_ROLE_KEY="SUBSTITUA_PELA_SERVICE_ROLE_LEGADA_NO_SERVIDOR"
